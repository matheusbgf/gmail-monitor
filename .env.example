# ==========================================================
# MDG - Monitoramento do Gmail
# Variáveis de ambiente
# ==========================================================


# ----------------------------------------------------------
# APLICAÇÃO
# ----------------------------------------------------------

APP_NAME=gmail-monitor
NODE_ENV=production
LOG_LEVEL=INFO


# ----------------------------------------------------------
# GMAIL
# ----------------------------------------------------------

# Arquivo de credenciais OAuth do Google

# Arquivo onde o token OAuth será armazenado

# Consulta utilizada para buscar e-mails

# Quantidade máxima de mensagens por consulta

# Intervalo entre verificações do Gmail
# 30000 = 30 segundos


# ----------------------------------------------------------
# WHATSAPP / BOT EXISTENTE
# ----------------------------------------------------------

# Ativa o envio de alertas para o WhatsApp
WHATSAPP_ENABLED=true

# API HTTP do bot WhatsApp existente
WHATSAPP_API_URL=http://127.0.0.1:3241

# Token da API do bot WhatsApp
WHATSAPP_API_TOKEN=

# ID do grupo que receberá os alertas
WHATSAPP_GROUP_ID=

# Tipo de mensagem
# 1 = checkpoint/imagem
# 2 = alerta de texto
WHATSAPP_MESSAGE_TYPE=2

# Timeout da comunicação com o bot
# 10000 = 10 segundos
WHATSAPP_API_TIMEOUT=10000


# ----------------------------------------------------------
# ESTADO
# ----------------------------------------------------------

# Arquivo que armazena os e-mails já processados
