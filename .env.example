# ==========================================================
# MDG - Monitoramento do Gmail
# Variáveis de ambiente
# ==========================================================


# ----------------------------------------------------------
# APLICAÇÃO
# ----------------------------------------------------------

APP_NAME=gmail-monitor
NODE_ENV=production
LOG_LEVEL=INFO


# ----------------------------------------------------------
# CAPTURA DO GMAIL E DO GRAFANA
# ----------------------------------------------------------

CHECKPOINT_ENABLED=true
CHECKPOINT_INTERVAL=3600000
CHECKPOINT_GMAIL_URL=https://mail.google.com/mail/u/0/
CHECKPOINT_GRAFANA_URL=
CHECKPOINT_BROWSER_HEADLESS=true
# Em desktop, true inicia o Chrome visível junto com `npm start` e conecta via CDP local.
CHECKPOINT_BROWSER_CDP_ENABLED=false
CHECKPOINT_BROWSER_CDP_ENDPOINT=http://127.0.0.1:9222
CHECKPOINT_CHROME_EXECUTABLE=google-chrome-stable
CHECKPOINT_BROWSER_DATA_DIR=./data/checkpoint-chrome
CHECKPOINT_SCREENSHOT_DIR=./data/checkpoints

# O perfil guarda cookies e fica restrito ao usuário do serviço (permissão 700).
# O verificador é headless: `node src/checkpoint/login.js` só valida uma sessão.
# Um perfil Gmail vazio não pode ser autenticado por senha/MFA automatizados.
# Para autenticação desde o primeiro uso sem navegador, é necessário Google
# Workspace com delegação de domínio e uma integração Gmail API (a captura da
# interface do Gmail deixa de ser usada).


# ----------------------------------------------------------
# WHATSAPP / BOT EXISTENTE
# ----------------------------------------------------------

# Ativa o envio de alertas para o WhatsApp
WHATSAPP_ENABLED=true

# API HTTP do bot WhatsApp existente
WHATSAPP_API_URL=http://127.0.0.1:3241

# Token da API do bot WhatsApp
WHATSAPP_API_TOKEN=

# ID do grupo que receberá os alertas
WHATSAPP_GROUP_ID=

# Tipo de mensagem
# 1 = checkpoint/imagem
# 2 = alerta de texto
WHATSAPP_MESSAGE_TYPE=2

# Timeout da comunicação com o bot
# 10000 = 10 segundos
WHATSAPP_API_TIMEOUT=10000


# ----------------------------------------------------------
# ESTADO
# ----------------------------------------------------------

# Arquivo que armazena os e-mails já processados
